# ==============================================================================
# Sile Backend Environment Configuration Template
# File: server/.env.example
# Copy this file to server/.env and fill in your actual credentials.
# NEVER commit server/.env to version control!
# ==============================================================================

# Port for the Node.js Express server (default: 5000)
PORT=5000

# Frontend URL for CORS configuration.
# The frontend package.json starts Vite on port 3000 ("vite --port=3000 --host=0.0.0.0").
# You may specify multiple comma-separated origins if needed (e.g. http://localhost:3000,http://127.0.0.1:3000).
FRONTEND_URL=http://localhost:3000

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (secret!)
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role
# CAUTION: This key bypasses Row Level Security. Keep it strictly on the backend!
# NEVER expose this key to frontend code or commit it to GitHub.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Node environment (development / production)
NODE_ENV=development
